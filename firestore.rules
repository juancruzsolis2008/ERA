rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isOwner() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isOwner == true;
    }
    function isMemberOfTeam(teamId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.members;
    }
    // NUEVO (Etapa 7) — Admin de club / Coordinador, vía memberships (no vía el
    // campo role plano). membershipId sigue el mismo convenio que ya usa el
    // cliente: clubId + '_club' para Admin de club (todos los deportes), o
    // clubId + '_' + sportId para Coordinador de un deporte puntual.
    function isClubAdmin(clubId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(clubId + '_club')) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(clubId + '_club')).data.role == 'admin';
    }
    function isCoordinadorOf(clubId, sportId) {
      return signedIn() && sportId != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(clubId + '_' + sportId)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(clubId + '_' + sportId)).data.role == 'coordinador';
    }
    function isClubStaff(clubId, sportId) {
      return isClubAdmin(clubId) || isCoordinadorOf(clubId, sportId);
    }
    function hasPendingInvite(teamId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/invites/$(teamId + '_' + request.auth.uid));
    }
    function acceptsOnlyOwnInvite(teamId) {
      return hasPendingInvite(teamId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
        request.resource.data.members.size() == resource.data.members.size() + 1 &&
        request.resource.data.members.hasAll(resource.data.members) &&
        request.auth.uid in request.resource.data.members;
    }
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
      match /exercises/{exerciseId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      match /routines/{routineId} {
        allow read, write: if isAdmin() || (signedIn() && request.auth.uid == uid);
      }
      match /preferences/{docId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      match /calendarEvents/{eventId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      match /customTests/{testId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      // NUEVO — memberships: qué club/deporte/rol/categorías tiene esta cuenta.
      // Mismo criterio que el doc users/{uid} en sí: solo isAdmin()/isOwner() puede
      // crear o modificar memberships (asignar rol es una acción administrativa),
      // el dueño de la cuenta puede leer las suyas. isAdmin() por ahora reconoce a
      // cualquier cuenta con role=='admin' global (hoy solo existe una, la del
      // Dueño) — cuando la Etapa 7 introduzca Admin de club/Coordinador como roles
      // scoped por club (ya no via el campo 'role' plano), esto hay que revisarlo
      // para que cada uno solo pueda asignar accesos dentro de SU club/deporte.
      match /memberships/{membershipId} {
        allow read: if isAdmin() || isOwner() || (signedIn() && request.auth.uid == uid);
        allow create, update, delete: if isAdmin() || isOwner();
      }
    }
    match /teams/{teamId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.members);
      // NUEVO (Etapa 7) — Admin de club/Coordinador puede crear/editar/borrar
      // categorías de SU club (y, si es Coordinador, de SU deporte dentro de ese
      // club). No ven automáticamente TODAS las categorías del club por tener el
      // rol — igual que antes, el acceso real a los datos de una categoría sigue
      // dependiendo de estar en teams.members (limitación conocida sin backend
      // propio, ver DATABASE.md). También nuevo: un Personal Trainer puede
      // crear/editar/borrar SUS PROPIAS categorías (clubId null, ownerUid el suyo
      // — mini-panel de Administración, sin club ni deporte).
      allow create: if isAdmin()
        || (request.resource.data.clubId != null && isClubStaff(request.resource.data.clubId, request.resource.data.sportId))
        || (request.resource.data.clubId == null && request.resource.data.ownerUid == request.auth.uid);
      allow delete: if isAdmin()
        || (resource.data.clubId != null && isClubStaff(resource.data.clubId, resource.data.sportId))
        || (resource.data.clubId == null && resource.data.ownerUid == request.auth.uid);
      allow update: if isAdmin() || acceptsOnlyOwnInvite(teamId)
        || (resource.data.clubId != null && isClubStaff(resource.data.clubId, resource.data.sportId))
        || (resource.data.clubId == null && resource.data.ownerUid == request.auth.uid);
      match /data/{docId} { allow read, write: if isAdmin() || isMemberOfTeam(teamId); }
      match /attendance/{docId} { allow read, write: if isAdmin() || isMemberOfTeam(teamId); }
      match /exercises/{exerciseId} { allow read, write: if isAdmin() || isMemberOfTeam(teamId); }
      match /lessonPlans/{planId} { allow read, write: if isAdmin() || isMemberOfTeam(teamId); }
      match /progress/{entryId} { allow read, write: if isAdmin() || isMemberOfTeam(teamId); }
      match /physicalEvaluations/{evalId} { allow read, write: if isAdmin() || isMemberOfTeam(teamId); }
      match /stats/{entryId} { allow read, write: if isAdmin() || isMemberOfTeam(teamId); }
      match /callups/{callupId} { allow read, write: if isAdmin() || isMemberOfTeam(teamId); }
    }
    match /invites/{inviteId} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.invitedUid == request.auth.uid) ||
        isMemberOfTeam(resource.data.teamId);
      allow create: if isAdmin() || isMemberOfTeam(request.resource.data.teamId);
      allow delete: if isAdmin() || isMemberOfTeam(resource.data.teamId) ||
        (signedIn() && resource.data.invitedUid == request.auth.uid);
    }
    match /physicalExerciseLibrary/{exerciseId} {
      allow read, write: if signedIn();
    }
    match /clubData/{docId} {
      allow read, write: if signedIn();
    }
    match /publicExerciseLibrary/{exerciseId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy.uid == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.createdBy.uid == request.auth.uid);
    }
    match /forumMessages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy.uid == request.auth.uid;
      // NUEVO — update: no existía ninguna regla de update acá (no hay función de
      // "editar mensaje" hoy, solo borrar). Hace falta para que migrateToMultiClub()
      // (Etapa 8) pueda completar clubId/sportId en mensajes viejos.
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.createdBy.uid == request.auth.uid);
    }
    // NUEVO — catálogo global de deportes de la plataforma. Solo el Dueño agrega
    // deportes nuevos (ej. "Handball" el día de mañana); cualquier cuenta logueada
    // puede leerlo (se usa para poblar selects de deporte en toda la app).
    match /sportsCatalog/{sportId} {
      allow read: if signedIn();
      allow write: if isOwner();
    }
    // NUEVO — clubes de la plataforma (nombre, logo, tema visual, deportes
    // habilitados, tope de categorías). Lectura abierta a cualquier logueado (se
    // necesita para aplicar el tema/logo del club y para validar límites al crear
    // una categoría).
    // Escritura: isAdmin()/isOwner() sin restricción de campo (Dueño global, sigue
    // igual que en la Etapa 3). Desde la Etapa 7, el Admin de club de ESE club
    // también puede escribir, pero SOLO el campo categoryCount (crear una
    // categoría nueva actualiza el contador) — enabledSports/maxCategories siguen
    // siendo exclusivos del Dueño, tal como pide el diseño ("es el control de plan
    // pago"). Coordinador (sin ser también Admin de club) NO tiene escritura acá:
    // si crea una categoría nueva, el contador del club simplemente no se
    // actualiza en ese caso — mismo tipo de límite ya documentado para
    // categoryCount en DATABASE.md (no atómico, sin backend propio).
    match /clubs/{clubId} {
      allow read: if signedIn();
      allow write: if isAdmin() || isOwner();
      allow update: if isClubAdmin(clubId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['categoryCount']);
    }
  }
}
